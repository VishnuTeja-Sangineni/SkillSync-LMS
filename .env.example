# SkillSync LMS - Environment Variables
# Copy this file to .env and fill in values

# Database: SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./skillsync.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/skillsync

# Security - REQUIRED in production (ENVIRONMENT=prod)
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - comma-separated origins, or * for all (dev only)
CORS_ORIGINS=*

# Environment: dev or prod
ENVIRONMENT=dev

# ML Model
MODEL_PATH=ml/artifacts/model.joblib
MODEL_STORAGE=local

# AWS (only if MODEL_STORAGE=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# Logging
LOG_LEVEL=INFO

# Server port (used by Dockerfile / cloud platforms)
PORT=8000
